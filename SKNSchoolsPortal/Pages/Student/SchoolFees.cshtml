@page
@inject UserManager<ApplicationUser> _userManager
@inject ApplicationDbContext _db
@model SKNSchoolsPortal.Pages.Student.SchoolFeesModel
@{
    ViewData["Title"] = "School Fees";

    var user = await _userManager.GetUserAsync(User);

    double totalAmount = 0;

    var userData = _db.Payments.Include(k => k.Termregistrations.SessionYear).Include(k => k.Termregistrations.Schoolclasses).Include(k => k.Termregistrations.SubClasses).Include(k => k.TermlyFees).Include(k => k.Termregistrations.StudentsData).Where(k => k.Termregistrations.StudentsData.ApplicationUserId == user.Id).ToList();

    totalAmount = userData.Sum(k => k.Paid);
}
@section Styles {
    <partial name="_dataTablesSheets" />
}
<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-cash-stack text-primary me-2"></i>School Fees Payment History</h5>
        <p class="text-muted mb-0" style="font-size:.88rem">View all your school fee payment records.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-sm rounded-pill">
            <i class="bi bi-download me-1"></i>Export
        </button>
        <button class="btn btn-primary btn-sm rounded-pill">
            <i class="bi bi-printer me-1"></i>Print
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="action-icon bg-success-soft"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="text-muted" style="font-size:.78rem">Total Paid</div>
                    <div class="fw-bold" style="font-size:1.1rem">@(SD.ToNaira(totalAmount))</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="action-icon bg-warning-soft"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="text-muted" style="font-size:.78rem">Pending</div>
                    <div class="fw-bold" style="font-size:1.1rem">&#8358;0.0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="action-icon bg-info-soft"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="text-muted" style="font-size:.78rem">Total Records</div>
                    <div class="fw-bold" style="font-size:1.1rem">@(userData.Count()) Payments</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card">
    <div class="card-body">
        <div class="filter-bar">
            <div class="flex-grow-1" style="min-width:200px;">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-secondary"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by reference, session..." id="searchInput" />
                </div>
            </div>
            <select class="form-select" style="max-width:160px">
                <option selected>All Sessions</option>
            </select>
            <select class="form-select" style="max-width:140px">
                <option selected>All Terms</option>
                <option>1st Term</option>
                <option>2nd Term</option>
                <option>3rd Term</option>
            </select>
            <select class="form-select" style="max-width:140px">
                <option selected>All Status</option>
                <option>Paid</option>
                <option>Pending</option>
                <option>Partial</option>
            </select>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table id="fee_payment" class="table table-boredered table-striped table-dashboard align-middle mb-3" width="100%">
                <thead class="">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Fees</th>
                        <th>Amount</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Session/Year</th>
                        <th>Term</th>
                        <th>Class</th>
                        <th>Date</th>
                    </tr>
                </thead>
            </table>

        </div>

    </div>
</div>
@section Scripts {
    <partial name="_dataTablesScripts" />
    <script src="~/js/site.js"></script>
}