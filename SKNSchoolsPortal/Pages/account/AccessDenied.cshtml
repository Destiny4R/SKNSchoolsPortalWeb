@page
@model SKNSchoolsPortal.Pages.account.AccessDeniedModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - SKN Schools</title>

    <link rel="shortcut icon" href="/appicons/favicon.ico">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bs-primary: #0f4c81;
            --bs-primary-rgb: 15, 76, 129;
            --sidebar-bg: #0b3d69;
        }

        body {
            background-color: #f0f2f5;
            font-family: 'Poppins', 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .denied-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, .1);
            overflow: hidden;
            max-width: 520px;
            width: 100%;
        }

        .denied-header {
            background: linear-gradient(135deg, var(--sidebar-bg) 0%, #0f4c81 100%);
            padding: 2.5rem 2rem 2rem;
            text-align: center;
            color: #fff;
            position: relative;
        }

        .denied-header::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 24px;
            background: #fff;
            border-radius: 16px 16px 0 0;
        }

        .denied-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .12);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            margin-bottom: 1rem;
        }

        .denied-body {
            padding: 1.5rem 2rem 2.5rem;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
            font-weight: 600;
        }

        .btn-primary:hover {
            background-color: #0a3d6b;
            border-color: #0a3d6b;
        }
    </style>
</head>
<body>

    <div class="container px-3">
        <div class="denied-card mx-auto">
            <div class="denied-header">
                <div class="denied-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bold mb-1">Access Denied</h3>
                <p class="mb-0 opacity-75" style="font-size:.9rem">Error 403 &mdash; Forbidden</p>
            </div>
            <div class="denied-body">
                <p class="text-secondary mb-4">
                    You do not have permission to access this page. If you believe this is an error, please contact your school administrator.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-house-door me-1"></i> Go Home
                    </a>
                    <a href="/account/login" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                </div>
            </div>
        </div>
        <div class="text-center mt-4 text-muted small">
            &copy; @DateTime.Now.Year SKN Schools, Apir, Makurdi. All rights reserved.
        </div>
    </div>

</body>
</html>
